{
  "name": "liushi-aweasome-agentic-engineering",
  "version": "0.0.0",
  "private": true,
  "description": "Agentic Engineering practices and reusable packages.",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm docs:lint && pnpm typecheck && pnpm test",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "docs:lint": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "release": "pnpm build && changeset publish",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
