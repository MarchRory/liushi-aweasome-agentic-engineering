{
  "name": "liushi-aweasome-agentic-engineering",
  "version": "0.0.0",
  "private": true,
  "description": "Agentic Engineering practices and reusable packages.",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm docs:lint && pnpm typecheck && pnpm test",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "docs:lint": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "release": "pnpm build && pnpm --filter liushi-harness smoke:package && changeset publish",
    "smoke:codex-host:prepare": "pnpm --filter liushi-harness build && node packages/liushi-harness/scripts/codexHostSmoke/index.mjs prepare",
    "smoke:codex-host:verify-result": "pnpm --filter liushi-harness build && node packages/liushi-harness/scripts/codexHostSmoke/index.mjs verify-result",
    "smoke:codex-host:verify": "pnpm --filter liushi-harness build && node packages/liushi-harness/scripts/codexHostSmoke/index.mjs verify",
    "pilot:codex-agent:prepare": "pnpm --filter liushi-harness build && node packages/liushi-harness/scripts/codexAgentPilot/index.mjs prepare",
    "pilot:codex-agent:approve": "pnpm --filter liushi-harness build && node packages/liushi-harness/scripts/codexAgentPilot/index.mjs approve",
    "pilot:codex-agent:preview-host": "pnpm --filter liushi-harness build && node packages/liushi-harness/scripts/codexAgentPilot/index.mjs preview-host",
    "pilot:codex-agent:closeout": "pnpm --filter liushi-harness build && node packages/liushi-harness/scripts/codexAgentPilot/index.mjs closeout",
    "smoke:package": "pnpm --filter liushi-harness build && pnpm --filter liushi-harness smoke:package",
    "smoke:public-project": "pnpm --filter liushi-harness smoke:public-project",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "62.9.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "markdownlint-cli2": "0.20.0",
    "prettier": "3.9.5",
    "tsup": "8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
